{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DailyComicArtifactContract",
  "description": "Terminal artifact contract for daily-comic.",
  "skill": "daily-comic",
  "slots": {
    "daily_comic_result": {
      "display_name": "Daily Comic Result",
      "content_type": "application/json",
      "produced_in": "Phase 4",
      "consumed_by": [],
      "promotable": true,
      "allowed_producers": ["daily-comic"],
      "verification": {
        "mode": "verify_and_promote",
        "required_fields": [
          "character_url",
          "core_emotion",
          "comic_style",
          "outfit_anchor",
          "aspect_ratio",
          "panels",
          "failed_panels",
          "quality_tier",
          "created_at"
        ]
      },
      "tags": ["composition", "terminal"]
    }
  },
  "completion": {
    "required_slots": ["daily_comic_result"],
    "terminal_slots": ["daily_comic_result"],
    "done_when": ["slot_promoted(daily_comic_result)"]
  },
  "failure_policy": {
    "ladder": ["retry", "alternate", "degrade", "partial_finalize", "emit_failure_metadata"],
    "minimum_viable_deliverable": "daily_comic_result",
    "partial_success_rules": [
      "At least 3 panels may be accepted in degraded mode."
    ]
  }
}
