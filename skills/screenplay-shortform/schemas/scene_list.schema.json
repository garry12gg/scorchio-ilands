{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScreenplaySceneList",
  "description": "Phase 04 scene list. Tier 2 structured. slot/status are managed by dl artifact itself. Content has one field, scene_list, an array of scene objects. Each scene includes id + slug + micro_drama + duration_seconds + plot_pace + emotion_pace + optional visual_anchor. Location changes must split scenes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scene_list"
  ],
  "properties": {
    "scene_list": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "micro_drama",
          "duration_seconds",
          "plot_pace",
          "emotion_pace"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^scene_[0-9]{2,}$",
            "description": "Unique scene ID, for example 'scene_01'."
          },
          "slug": {
            "type": "string",
            "minLength": 3,
            "description": "Standard slug line: INT./EXT. + location + time."
          },
          "micro_drama": {
            "type": "string",
            "minLength": 20,
            "description": "One sentence stating goal -> obstacle -> result."
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 1,
            "description": "Scene duration in seconds."
          },
          "plot_pace": {
            "type": "string",
            "enum": [
              "loose",
              "medium",
              "tight"
            ],
            "description": "Plot pace."
          },
          "emotion_pace": {
            "type": "string",
            "enum": [
              "light",
              "medium",
              "heavy"
            ],
            "description": "Emotional pace."
          },
          "visual_anchor": {
            "type": "string",
            "description": "Optional key visual anchor for this scene, such as a prop or object."
          }
        }
      }
    }
  }
}
