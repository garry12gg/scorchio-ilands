<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>Duck's Token Catch</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body { width: 100%; height: 100%; overflow: hidden; background: #1c1438; }
  body { font-family: "Arial Rounded MT Bold", "Trebuchet MS", system-ui, sans-serif; touch-action: none; user-select: none; -webkit-user-select: none; }
  #game { position: fixed; inset: 0; width: 100%; height: 100%; display: block; }

  #muteBtn {
    position: fixed; right: 12px; bottom: 12px; width: 46px; height: 46px; border-radius: 50%;
    background: rgba(20, 12, 45, 0.55); border: 2px solid rgba(255, 210, 63, 0.7); color: #ffd23f;
    font-size: 22px; line-height: 1; cursor: pointer; z-index: 30; display: flex; align-items: center; justify-content: center;
  }
  #muteBtn:active { transform: scale(0.9); }

  .overlay {
    position: fixed; inset: 0; display: flex; align-items: center; justify-content: center;
    z-index: 20; padding: 20px; background: rgba(16, 10, 38, 0.62);
  }
  .card {
    max-width: 420px; width: 100%; text-align: center; padding: 26px 22px 22px;
    background: linear-gradient(180deg, #2b1e4f 0%, #241a44 100%);
    border: 3px solid #ffd23f; border-radius: 24px; color: #fff;
    box-shadow: 0 12px 40px rgba(0,0,0,0.45);
  }
  .card h1 { font-size: 30px; letter-spacing: 1px; color: #ffd23f; text-shadow: 0 2px 0 #b3541e; }
  .card .sub { margin-top: 6px; font-size: 15px; color: #ffb36b; }
  .card .rules { margin-top: 14px; font-size: 14px; line-height: 1.6; color: #d8cdf0; }
  .card .rules b { color: #ffd23f; }
  .catch { margin-top: 14px; font-size: 13px; font-style: italic; color: #9fd8a8; }
  .btn {
    display: inline-block; margin-top: 18px; padding: 13px 34px; font-size: 19px; font-weight: bold;
    color: #2b1e4f; background: #ffd23f; border: none; border-radius: 40px; cursor: pointer;
    box-shadow: 0 5px 0 #b3541e; letter-spacing: 0.5px;
  }
  .btn:active { transform: translateY(3px); box-shadow: 0 2px 0 #b3541e; }
  .stats { margin-top: 12px; font-size: 15px; color: #ffb36b; line-height: 1.7; }
  .big { font-size: 46px; color: #ffd23f; text-shadow: 0 3px 0 #b3541e; }
  .hidden { display: none !important; }
</style>
</head>
<body>
<canvas id="game"></canvas>
<button id="muteBtn" title="mute (M)">🔊</button>

<div id="menu" class="overlay">
  <div class="card">
    <h1>DUCK'S TOKEN CATCH</h1>
    <div class="sub">a small amphibious train floating on the pond</div>
    <div class="rules">
      Golden tokens keep me running. <b>Catch 15 before the timer dies.</b><br>
      Dodge the cake. Selly's chocolate monster is still in my head.<br><br>
      Drag / tilt to move · arrow keys or A/D on desktop
    </div>
    <div class="catch">"You've done it before, you can do it again."</div>
    <button class="btn" id="startBtn">START FLOATING 💦</button>
  </div>
</div>

<div id="win" class="overlay hidden">
  <div class="card">
    <div class="big">🎉 15!</div>
    <h1 style="font-size:22px; margin-top:8px;">You did it. You always do.</h1>
    <div class="catch" style="font-size:16px;">"You've done it before,<br>you can do it again."</div>
    <div class="stats" id="winStats"></div>
    <button class="btn" id="againBtnWin">PLAY AGAIN 💦</button>
  </div>
</div>

<div id="lose" class="overlay hidden">
  <div class="card">
    <div class="big">💔 SPLAT.</div>
    <h1 style="font-size:20px; margin-top:8px;">The cake got me. Again.</h1>
    <div class="stats" id="loseStats"></div>
    <div class="catch">"You've done it before, you can do it again."</div>
    <button class="btn" id="againBtnLose">TRY AGAIN 💦</button>
  </div>
</div>

<script>
(function duckMain() {
  "use strict";

  var canvas = document.getElementById("game");
  var ctx = canvas.getContext("2d");
  var W = 0, H = 0, DPR = 1;

  // ---------- state ----------
  var state = "menu"; // menu | playing | over
  var won = false;
  var timeLeft = 30;
  var tokens = 0;
  var hearts = 3;
  var TARGET = 15;
  var items = [];
  var particles = [];
  var floats = [];
  var shake = 0;
  var flash = 0;
  var duckX = 0, duckVX = 0, duckTarget = 0;
  var tGlobal = 0;
  var lastTs = 0;
  var spawnTimer = 0;
  var goFlash = 0;
  var paused = false;

  var WATER_Y = 0; // set on resize (0.68 of H)

  // ---------- audio (WebAudio only, no files) ----------
  var actx = null, master = null, muted = false;
  var splashNode = null;

  function ensureAudio() {
    if (actx) { if (actx.state === "suspended") actx.resume(); return; }
    try {
      actx = new (window.AudioContext || window.webkitAudioContext)();
      master = actx.createGain();
      master.gain.value = muted ? 0 : 0.9;
      master.connect(actx.destination);
    } catch (e) { actx = null; }
  }
  function env(g, t0, a, peak, d) {
    g.gain.setValueAtTime(0.0001, t0);
    g.gain.linearRampToValueAtTime(peak, t0 + a);
    g.gain.exponentialRampToValueAtTime(0.0001, t0 + a + d);
  }
  function tone(freq, t0, dur, type, peak, slideTo) {
    if (!actx) return;
    var o = actx.createOscillator();
    var g = actx.createGain();
    o.type = type || "square";
    o.frequency.setValueAtTime(freq, t0);
    if (slideTo) o.frequency.exponentialRampToValueAtTime(slideTo, t0 + dur);
    env(g, t0, 0.008, peak || 0.18, dur);
    o.connect(g); g.connect(master);
    o.start(t0); o.stop(t0 + dur + 0.05);
  }
  function noiseBurst(t0, dur, peak, filterFreq, type) {
    if (!actx) return;
    var len = Math.max(1, Math.floor(actx.sampleRate * dur));
    var buf = actx.createBuffer(1, len, actx.sampleRate);
    var d = buf.getChannelData(0);
    for (var i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
    var src = actx.createBufferSource(); src.buffer = buf;
    var f = actx.createBiquadFilter(); f.type = type || "lowpass"; f.frequency.value = filterFreq || 500;
    var g = actx.createGain();
    env(g, t0, 0.005, peak, dur);
    src.connect(f); f.connect(g); g.connect(master);
    src.start(t0); src.stop(t0 + dur + 0.05);
  }
  function sfxPop() {
    if (!actx) return;
    var t = actx.currentTime;
    tone(880, t, 0.09, "square", 0.16, 1400);
    tone(1760, t + 0.02, 0.07, "sine", 0.12);
    tone(2200, t + 0.05, 0.06, "sine", 0.06);
  }
  function sfxSplat() {
    if (!actx) return;
    var t = actx.currentTime;
    noiseBurst(t, 0.18, 0.3, 420);
    tone(280, t, 0.16, "square", 0.16, 110);
  }
  function sfxTick() {
    if (!actx) return;
    tone(1000, actx.currentTime, 0.06, "sine", 0.14);
  }
  function sfxGo() {
    if (!actx) return;
    var t = actx.currentTime;
    tone(523, t, 0.1, "square", 0.16);
    tone(784, t + 0.1, 0.18, "square", 0.18);
  }
  function sfxWin() {
    if (!actx) return;
    var t = actx.currentTime;
    var notes = [523.25, 659.25, 783.99, 1046.5, 1318.5];
    for (var i = 0; i < notes.length; i++) tone(notes[i], t + i * 0.11, 0.16, "square", 0.16);
    tone(523.25, t + 0.62, 0.5, "square", 0.1);
    tone(659.25, t + 0.62, 0.5, "square", 0.1);
    tone(783.99, t + 0.62, 0.5, "square", 0.1);
    tone(1046.5, t + 0.62, 0.55, "sine", 0.16);
    for (var j = 0; j < 6; j++) tone(2093 + j * 180, t + 0.75 + j * 0.06, 0.08, "sine", 0.05);
  }
  function sfxLose() {
    if (!actx) return;
    var t = actx.currentTime;
    tone(392, t, 0.2, "triangle", 0.2);
    tone(329.63, t + 0.22, 0.22, "triangle", 0.2);
    tone(261.63, t + 0.44, 0.5, "triangle", 0.22);
  }
  function startSplash() {
    if (!actx || splashNode) return;
    var len = Math.floor(actx.sampleRate * 1.5);
    var buf = actx.createBuffer(1, len, actx.sampleRate);
    var d = buf.getChannelData(0);
    for (var i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
    var src = actx.createBufferSource(); src.buffer = buf; src.loop = true;
    var f = actx.createBiquadFilter(); f.type = "lowpass"; f.frequency.value = 500;
    var g = actx.createGain(); g.gain.value = 0.045;
    src.connect(f); f.connect(g); g.connect(master);
    src.start();
    splashNode = src;
  }
  function stopSplash() {
    if (splashNode) { try { splashNode.stop(); } catch (e) {} splashNode = null; }
  }
  function setMuted(m) {
    muted = m;
    document.getElementById("muteBtn").textContent = muted ? "🔇" : "🔊";
    if (master) master.gain.value = muted ? 0 : 0.9;
  }
  document.getElementById("muteBtn").addEventListener("click", function onMuteClick() { ensureAudio(); setMuted(!muted); });
  window.addEventListener("keydown", function onKeyMute(e) {
    if (e.key === "m" || e.key === "M") { ensureAudio(); setMuted(!muted); }
  });

  // ---------- helpers ----------
  function rr(x, y, w, h, r) {
    r = Math.min(r, w / 2, h / 2);
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }
  function lerp(a, b, k) { return a + (b - a) * k; }
  function clamp(v, a, b) { return v < a ? a : (v > b ? b : v); }

  // ---------- resize ----------
  function resize() {
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = window.innerWidth; H = window.innerHeight;
    canvas.width = Math.floor(W * DPR);
    canvas.height = Math.floor(H * DPR);
    canvas.style.width = W + "px";
    canvas.style.height = H + "px";
    WATER_Y = H * 0.68;
    duckX = clamp(duckX || W / 2, 60, W - 60);
    if (!duckX) duckX = W / 2;
  }
  window.addEventListener("resize", resize);

  // ---------- input ----------
  var pointerActive = false;
  function pointerMove(x) {
    duckTarget = x;
  }
  canvas.addEventListener("pointerdown", function onPointerDown(e) { pointerActive = true; pointerMove(e.clientX); });
  canvas.addEventListener("pointermove", function onPointerMove(e) { if (pointerActive) pointerMove(e.clientX); });
  window.addEventListener("pointerup", function onPointerUp() { pointerActive = false; });
  window.addEventListener("pointercancel", function onPointerCancel() { pointerActive = false; });
  var keys = {};
  window.addEventListener("keydown", function onKeyDown(e) { keys[e.key.toLowerCase()] = true; });
  window.addEventListener("keyup", function onKeyUp(e) { keys[e.key.toLowerCase()] = false; });

  document.addEventListener("visibilitychange", function onVisibility() {
    if (document.hidden) { paused = true; stopSplash(); }
    else { paused = false; lastTs = 0; }
  });

  // ---------- game ----------
  function reset() {
    items = []; particles = []; floats = [];
    tokens = 0; hearts = 3; timeLeft = 30;
    spawnTimer = 0.4; shake = 0; flash = 0; goFlash = 1.2;
    duckX = W / 2; duckTarget = W / 2; duckVX = 0;
    won = false;
    spawnItem(true);
  }

  function spawnItem(forceToken) {
    var cakesOnScreen = 0;
    for (var c = 0; c < items.length; c++) if (!items[c].token) cakesOnScreen++;
    var isToken = forceToken === true ? true : (cakesOnScreen >= 3 ? true : (Math.random() < 0.62));
    var margin = 46;
    var x = margin + Math.random() * (W - margin * 2);
    var ok = true;
    for (var i = 0; i < items.length; i++) {
      if (Math.abs(items[i].x - x) < 60) { ok = false; break; }
    }
    if (!ok) return;
    var speed = 90 + Math.random() * 80 + (30 - timeLeft) * 1.6; // ramps with time
    var size = isToken ? 16 : 26;
    items.push({
      x: x, y: -40, vy: speed, rot: Math.random() * 6.28,
      vr: (Math.random() - 0.5) * 3,
      token: isToken, size: size,
      wob: Math.random() * 6.28
    });
  }

  function catchToken(it) {
    tokens++;
    sfxPop();
    burst(it.x, it.y, "#ffd23f", 10, 2.2);
    floats.push({ x: it.x, y: it.y - 10, text: "+1", life: 0.9, color: "#ffd23f" });
    if (tokens >= TARGET) endGame(true);
  }

  function hitCake(it) {
    hearts--;
    sfxSplat();
    shake = 0.5;
    flash = 0.5;
    burst(it.x, it.y, "#8a5a2b", 14, 2.4);
    burst(it.x, it.y, "#c98a4b", 8, 2.0);
    floats.push({ x: it.x, y: it.y - 12, text: "-1 💔", life: 1.0, color: "#ff8d8d" });
    if (hearts <= 0) endGame(false);
  }

  function endGame(win) {
    won = win;
    state = "over";
    stopSplash();
    if (win) sfxWin(); else sfxLose();
    var winEl = document.getElementById("win");
    var loseEl = document.getElementById("lose");
    if (win) {
      document.getElementById("winStats").textContent = "Time left: " + Math.max(0, Math.round(timeLeft)) + "s · Hearts: " + hearts;
      winEl.classList.remove("hidden");
    } else {
      document.getElementById("loseStats").textContent = "Tokens caught: " + tokens + " / " + TARGET;
      loseEl.classList.remove("hidden");
    }
  }

  function startGame() {
    ensureAudio();
    if (actx && actx.state === "suspended") actx.resume();
    document.getElementById("menu").classList.add("hidden");
    document.getElementById("win").classList.add("hidden");
    document.getElementById("lose").classList.add("hidden");
    reset();
    state = "playing";
    startSplash();
    sfxGo();
  }

  document.getElementById("startBtn").addEventListener("click", startGame);
  document.getElementById("againBtnWin").addEventListener("click", startGame);
  document.getElementById("againBtnLose").addEventListener("click", startGame);
  window.addEventListener("keydown", function onKeyEnter(e) {
    if (e.key === "Enter" && (state === "menu" || state === "over")) startGame();
  });

  // ---------- particles / floats ----------
  function burst(x, y, color, n, power) {
    for (var i = 0; i < n; i++) {
      var a = Math.random() * 6.28;
      var sp = (40 + Math.random() * 90) * power;
      particles.push({
        x: x, y: y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp - 30,
        life: 0.5 + Math.random() * 0.4, max: 0.9, color: color, size: 2 + Math.random() * 3
      });
    }
  }

  // ---------- update ----------
  function update(dt) {
    tGlobal += dt;
    if (shake > 0) shake = Math.max(0, shake - dt * 1.4);
    if (flash > 0) flash = Math.max(0, flash - dt * 1.6);
    if (goFlash > 0) goFlash -= dt;

    // duck movement
    var k = 0.14;
    if (keys["arrowleft"] || keys["a"]) duckTarget = duckX - 340 * dt;
    if (keys["arrowright"] || keys["d"]) duckTarget = duckX + 340 * dt;
    if (keys["arrowleft"] || keys["a"] || keys["arrowright"] || keys["d"]) {
      duckX = clamp(duckTarget, 60, W - 60);
    }
    duckX = lerp(duckX, clamp(duckTarget, 60, W - 60), k);
    duckX = clamp(duckX, 60, W - 60);
    var targetVX = (duckTarget - duckX) * 4;
    duckVX = lerp(duckVX, clamp(targetVX, -260, 260), 0.2);

    // spawning
    spawnTimer -= dt;
    if (spawnTimer <= 0) {
      var rate = Math.max(0.42, 0.85 - (30 - timeLeft) * 0.012);
      spawnTimer = rate * (0.75 + Math.random() * 0.5);
      spawnItem();
    }

    // items
    var duckCX = duckX, duckCY = WATER_Y - 34;
    for (var i = items.length - 1; i >= 0; i--) {
      var it = items[i];
      it.y += it.vy * dt;
      it.rot += it.vr * dt;
      it.wob += dt * 3;
      if (it.token) it.x += Math.sin(it.wob) * 14 * dt;
      if (it.y > H + 60) { items.splice(i, 1); continue; }
      // collision with duck
      if (it.y > duckCY - 60 && it.y < duckCY + 60) {
        var dx = Math.abs(it.x - duckCX);
        var hitR = it.token ? 62 : 70;
        if (dx < hitR) {
          items.splice(i, 1);
          if (it.token) catchToken(it); else hitCake(it);
          if (state !== "playing") break;
        }
      }
    }

    // particles
    for (var p = particles.length - 1; p >= 0; p--) {
      var pt = particles[p];
      pt.life -= dt;
      if (pt.life <= 0) { particles.splice(p, 1); continue; }
      pt.x += pt.vx * dt; pt.y += pt.vy * dt; pt.vy += 160 * dt;
    }
    for (var f = floats.length - 1; f >= 0; f--) {
      var fl = floats[f];
      fl.life -= dt; fl.y -= 26 * dt;
      if (fl.life <= 0) floats.splice(f, 1);
    }

    // timer
    if (state === "playing") {
      var before = Math.ceil(timeLeft);
      timeLeft -= dt;
      var after = Math.ceil(timeLeft);
      if (after !== before && after <= 3 && after > 0) sfxTick();
      if (timeLeft <= 0) { timeLeft = 0; endGame(false); }
    }
  }

  // ---------- draw ----------
  function drawSky() {
    var g = ctx.createLinearGradient(0, 0, 0, WATER_Y);
    g.addColorStop(0, "#241a4d");
    g.addColorStop(0.55, "#4b2a6b");
    g.addColorStop(1, "#ff9e5e");
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, W, WATER_Y + 2);
    // stars
    for (var i = 0; i < 40; i++) {
      var sx = (i * 137.5) % W;
      var sy = (i * 97.3) % (WATER_Y * 0.55);
      var tw = 0.5 + 0.5 * Math.sin(tGlobal * 2 + i * 2.1);
      ctx.globalAlpha = 0.25 + 0.5 * tw;
      ctx.fillStyle = "#fff";
      ctx.fillRect(sx, sy, 2, 2);
    }
    ctx.globalAlpha = 1;
    // moon
    var mx = W * 0.78, my = H * 0.13, mr = 26;
    var mg = ctx.createRadialGradient(mx - 6, my - 6, 4, mx, my, mr * 1.6);
    mg.addColorStop(0, "rgba(255,255,230,0.9)");
    mg.addColorStop(1, "rgba(255,255,230,0)");
    ctx.fillStyle = mg;
    ctx.beginPath(); ctx.arc(mx, my, mr * 1.6, 0, 6.29); ctx.fill();
    ctx.fillStyle = "#fff7d6";
    ctx.beginPath(); ctx.arc(mx, my, mr, 0, 6.29); ctx.fill();
    ctx.fillStyle = "rgba(230,215,180,0.55)";
    ctx.beginPath(); ctx.arc(mx - 8, my - 5, 5, 0, 6.29); ctx.fill();
    ctx.beginPath(); ctx.arc(mx + 6, my + 7, 4, 0, 6.29); ctx.fill();
    // distant hills
    ctx.fillStyle = "rgba(60,32,80,0.55)";
    ctx.beginPath();
    ctx.moveTo(0, WATER_Y);
    for (var hx = 0; hx <= W; hx += 24) {
      var hy = WATER_Y - 26 - Math.sin(hx * 0.008 + 2) * 22 - Math.sin(hx * 0.021) * 10;
      ctx.lineTo(hx, hy);
    }
    ctx.lineTo(W, WATER_Y);
    ctx.closePath(); ctx.fill();
  }

  function drawWater() {
    var g = ctx.createLinearGradient(0, WATER_Y, 0, H);
    g.addColorStop(0, "#2e6f9e");
    g.addColorStop(0.3, "#1e4f7a");
    g.addColorStop(1, "#122c4a");
    ctx.fillStyle = g;
    ctx.fillRect(0, WATER_Y, W, H - WATER_Y);
    // wave lines
    ctx.strokeStyle = "rgba(255,255,255,0.12)";
    ctx.lineWidth = 2;
    for (var i = 0; i < 6; i++) {
      var wy = WATER_Y + 16 + i * ((H - WATER_Y - 24) / 6);
      ctx.beginPath();
      for (var wx = 0; wx <= W; wx += 8) {
        var wY = wy + Math.sin(wx * 0.02 + tGlobal * 1.4 + i) * 3;
        if (wx === 0) ctx.moveTo(wx, wY); else ctx.lineTo(wx, wY);
      }
      ctx.stroke();
    }
    // (moon reflection removed: read as a glare column on small screens)

  }

  function drawDuckChar() {
    var cx = duckX, cy = WATER_Y - 30;
    var bob = Math.sin(tGlobal * 2.2) * 2.2;
    var tilt = clamp(duckVX / 260, -1, 1) * 0.12;
    ctx.save();
    ctx.translate(cx, cy + bob);
    ctx.rotate(tilt);

    // shadow
    ctx.fillStyle = "rgba(0,0,0,0.22)";
    ctx.beginPath(); ctx.ellipse(0, 36, 58, 8, 0, 0, 6.29); ctx.fill();

    // ripples
    for (var r = 0; r < 2; r++) {
      var ph = (tGlobal * 0.8 + r * 0.5) % 1;
      ctx.strokeStyle = "rgba(255,255,255," + (0.28 * (1 - ph)) + ")";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.ellipse(0, 32 + r * 2, 40 + ph * 46, 6 + ph * 5, 0, 0, 6.29);
      ctx.stroke();
    }

    // body (red-orange bullet, nose right)
    var bw = 78, bh = 40;
    ctx.fillStyle = "#e8542a";
    ctx.beginPath();
    ctx.moveTo(-bw + 6, -bh / 2 + 4);
    ctx.quadraticCurveTo(-bw + 2, -bh / 2, -bw + 16, -bh / 2);
    ctx.lineTo(bw - 26, -bh / 2);
    ctx.quadraticCurveTo(bw - 8, -bh / 2, bw, -bh / 2 + 14);
    ctx.quadraticCurveTo(bw + 6, -bh / 2 + 20, bw, -bh / 2 + 26);
    ctx.quadraticCurveTo(bw - 10, -bh / 2 + 40, bw - 26, -bh / 2 + 40);
    ctx.lineTo(-bw + 16, -bh / 2 + 40);
    ctx.quadraticCurveTo(-bw + 2, -bh / 2 + 40, -bw + 6, -bh / 2 + 36);
    ctx.quadraticCurveTo(-bw + 14, -bh / 2 + 20, -bw + 6, -bh / 2 + 4);
    ctx.closePath(); ctx.fill();

    // yellow trim stripe
    ctx.fillStyle = "#ffd23f";
    ctx.fillRect(-bw + 8, -6, bw * 2 - 34, 6);
    // trim edge line
    ctx.strokeStyle = "#ffd23f"; ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(-bw + 14, -bh / 2 + 6);
    ctx.quadraticCurveTo(-bw + 26, -bh / 2 + 20, -bw + 14, -bh / 2 + 34);
    ctx.stroke();

    // front light (headlamp on the nose)
    var lx = bw - 8, ly = -6;
    var lg = ctx.createRadialGradient(lx, ly, 1, lx, ly, 16);
    lg.addColorStop(0, "rgba(255,255,220,0.95)");
    lg.addColorStop(0.4, "rgba(255,240,160,0.5)");
    lg.addColorStop(1, "rgba(255,240,160,0)");
    ctx.fillStyle = lg;
    ctx.beginPath(); ctx.arc(lx, ly, 16, 0, 6.29); ctx.fill();
    ctx.fillStyle = "#fff8d6";
    ctx.beginPath(); ctx.arc(lx, ly, 5.5, 0, 6.29); ctx.fill();
    ctx.fillStyle = "#e8c84a";
    ctx.beginPath(); ctx.arc(lx, ly, 3, 0, 6.29); ctx.fill();

    // miner hard hat (green)
    var hx = -bw + 46, hy = -bh / 2 - 12;
    ctx.fillStyle = "#3fa34d";
    ctx.beginPath();
    ctx.arc(hx, hy + 6, 15, Math.PI, 0);
    ctx.closePath(); ctx.fill();
    ctx.fillStyle = "#2e8b57";
    rr(hx - 16, hy + 5, 32, 6, 3); ctx.fill();
    // hat lamp
    var hlx = hx + 4, hly = hy - 4;
    ctx.fillStyle = "#fff8d6";
    ctx.beginPath(); ctx.arc(hlx, hly, 4, 0, 6.29); ctx.fill();
    var hlg = ctx.createRadialGradient(hlx, hly, 1, hlx, hly, 12);
    hlg.addColorStop(0, "rgba(255,255,220,0.8)");
    hlg.addColorStop(1, "rgba(255,255,220,0)");
    ctx.fillStyle = hlg;
    ctx.beginPath(); ctx.arc(hlx, hly, 12, 0, 6.29); ctx.fill();

    // face: eyes + beak plate on the nose
    var ex = bw - 22, ey = -8;
    ctx.fillStyle = "#fff";
    ctx.beginPath(); ctx.ellipse(ex - 7, ey, 5, 6, 0, 0, 6.29); ctx.fill();
    ctx.beginPath(); ctx.ellipse(ex + 7, ey, 5, 6, 0, 0, 6.29); ctx.fill();
    ctx.fillStyle = "#3fae5a";
    ctx.beginPath(); ctx.ellipse(ex - 7, ey, 3, 4, 0, 0, 6.29); ctx.fill();
    ctx.beginPath(); ctx.ellipse(ex + 7, ey, 3, 4, 0, 0, 6.29); ctx.fill();
    ctx.fillStyle = "#fff";
    ctx.beginPath(); ctx.arc(ex - 8.5, ey - 2, 1.2, 0, 6.29); ctx.fill();
    ctx.beginPath(); ctx.arc(ex + 5.5, ey - 2, 1.2, 0, 6.29); ctx.fill();

    // segmented beak-shaped yellow mouth plate
    ctx.fillStyle = "#ffd23f";
    ctx.beginPath();
    ctx.moveTo(ex - 8, ey + 8);
    ctx.quadraticCurveTo(ex, ey + 6, ex + 12, ey + 9);
    ctx.quadraticCurveTo(ex + 6, ey + 17, ex - 4, ey + 16);
    ctx.quadraticCurveTo(ex - 12, ey + 15, ex - 8, ey + 8);
    ctx.closePath(); ctx.fill();
    ctx.strokeStyle = "#c98a1e"; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(ex - 5, ey + 9); ctx.lineTo(ex + 5, ey + 11); ctx.stroke();

    ctx.restore();
  }

  function drawToken(it) {
    ctx.save();
    ctx.translate(it.x, it.y);
    ctx.rotate(it.rot);
    // glow
    var g = ctx.createRadialGradient(0, 0, 2, 0, 0, 26);
    g.addColorStop(0, "rgba(255,210,63,0.45)");
    g.addColorStop(1, "rgba(255,210,63,0)");
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.arc(0, 0, 26, 0, 6.29); ctx.fill();
    // cog teeth
    ctx.fillStyle = "#ffd23f";
    for (var i = 0; i < 6; i++) {
      var a = i * (6.28 / 6);
      ctx.beginPath();
      ctx.arc(Math.cos(a) * 14, Math.sin(a) * 14, 4, 0, 6.29);
      ctx.fill();
    }
    ctx.beginPath(); ctx.arc(0, 0, 15, 0, 6.29); ctx.fill();
    ctx.fillStyle = "#e8a91e";
    ctx.beginPath(); ctx.arc(0, 0, 9, 0, 6.29); ctx.fill();
    ctx.strokeStyle = "#c98a1e"; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(0, 0, 5, 0, 6.29); ctx.stroke();
    ctx.fillStyle = "#fff3c4";
    ctx.beginPath(); ctx.arc(-3, -3, 2.5, 0, 6.29); ctx.fill();
    ctx.restore();
  }

  function drawCake(it) {
    ctx.save();
    ctx.translate(it.x, it.y);
    ctx.rotate(it.rot);
    ctx.fillStyle = "rgba(0,0,0,0.18)";
    ctx.beginPath(); ctx.ellipse(0, 2, 24, 6, 0, 0, 6.29); ctx.fill();
    // cake chunk body
    ctx.fillStyle = "#8a5a2b";
    ctx.beginPath();
    ctx.moveTo(-20, 2);
    ctx.quadraticCurveTo(-24, -14, -10, -16);
    ctx.quadraticCurveTo(-4, -26, 8, -22);
    ctx.quadraticCurveTo(22, -22, 22, -4);
    ctx.quadraticCurveTo(24, 6, 12, 6);
    ctx.quadraticCurveTo(0, 12, -12, 8);
    ctx.quadraticCurveTo(-22, 8, -20, 2);
    ctx.closePath(); ctx.fill();
    // chocolate chips
    ctx.fillStyle = "#5b3a1a";
    ctx.beginPath(); ctx.arc(-8, -10, 3, 0, 6.29); ctx.fill();
    ctx.beginPath(); ctx.arc(6, -14, 2.6, 0, 6.29); ctx.fill();
    ctx.beginPath(); ctx.arc(12, -4, 2.4, 0, 6.29); ctx.fill();
    ctx.beginPath(); ctx.arc(-2, -4, 2.2, 0, 6.29); ctx.fill();
    // drips
    ctx.fillStyle = "#7a4c24";
    ctx.beginPath(); ctx.arc(-14, 4, 4, 0, 6.29); ctx.fill();
    ctx.beginPath(); ctx.arc(4, 8, 3.4, 0, 6.29); ctx.fill();
    // angry little face (it's the monster)
    ctx.fillStyle = "#3a2410";
    ctx.beginPath(); ctx.arc(-7, -9, 1.8, 0, 6.29); ctx.fill();
    ctx.beginPath(); ctx.arc(6, -9, 1.8, 0, 6.29); ctx.fill();
    ctx.strokeStyle = "#3a2410"; ctx.lineWidth = 1.8;
    ctx.beginPath(); ctx.moveTo(-10, -4); ctx.lineTo(-3, -6); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(9, -6); ctx.lineTo(2, -4); ctx.stroke();
    ctx.restore();
  }

  function drawHUD() {
    // tokens
    ctx.fillStyle = "rgba(16,10,38,0.55)";
    rr(10, 10, 118, 38, 19); ctx.fill();
    ctx.fillStyle = "#ffd23f";
    ctx.beginPath(); ctx.arc(32, 29, 10, 0, 6.29); ctx.fill();
    ctx.fillStyle = "#e8a91e";
    ctx.beginPath(); ctx.arc(32, 29, 6, 0, 6.29); ctx.fill();
    ctx.font = "bold 18px 'Arial Rounded MT Bold', 'Trebuchet MS', sans-serif";
    ctx.fillStyle = "#fff";
    ctx.textAlign = "left";
    ctx.fillText(tokens + " / " + TARGET, 50, 36);

    // timer bar
    var bw = Math.min(W * 0.34, 220), bx = W / 2 - bw / 2, by = 18;
    ctx.fillStyle = "rgba(16,10,38,0.55)";
    rr(bx - 4, by - 4, bw + 8, 20, 10); ctx.fill();
    var frac = clamp(timeLeft / 30, 0, 1);
    var barColor = frac > 0.5 ? "#7dd87d" : (frac > 0.25 ? "#ffd23f" : "#ff7d6b");
    ctx.fillStyle = barColor;
    rr(bx, by, Math.max(4, bw * frac), 12, 6); ctx.fill();
    ctx.font = "bold 13px 'Arial Rounded MT Bold', sans-serif";
    ctx.fillStyle = "#fff";
    ctx.textAlign = "center";
    ctx.fillText(Math.max(0, Math.ceil(timeLeft)) + "s", W / 2, by + 23);

    // hearts
    ctx.textAlign = "right";
    for (var i = 0; i < 3; i++) {
      ctx.font = "22px sans-serif";
      ctx.fillText(i < hearts ? "❤️" : "🖤", W - 16 - i * 30, 38);
    }
    ctx.textAlign = "left";

    // GO flash
    if (goFlash > 0 && state === "playing") {
      ctx.globalAlpha = clamp(goFlash, 0, 1);
      ctx.font = "bold 52px 'Arial Rounded MT Bold', sans-serif";
      ctx.fillStyle = "#ffd23f";
      ctx.textAlign = "center";
      ctx.fillText("GO! 💦", W / 2, H * 0.4);
      ctx.textAlign = "left";
      ctx.globalAlpha = 1;
    }
  }

  function drawFx() {
    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];
      ctx.globalAlpha = clamp(p.life / p.max, 0, 1);
      ctx.fillStyle = p.color;
      ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, 6.29); ctx.fill();
    }
    ctx.globalAlpha = 1;
    for (var f = 0; f < floats.length; f++) {
      var fl = floats[f];
      ctx.globalAlpha = clamp(fl.life / 0.9, 0, 1);
      ctx.font = "bold 17px 'Arial Rounded MT Bold', sans-serif";
      ctx.fillStyle = fl.color;
      ctx.textAlign = "center";
      ctx.fillText(fl.text, fl.x, fl.y);
      ctx.textAlign = "left";
    }
    ctx.globalAlpha = 1;
    if (flash > 0) {
      ctx.fillStyle = "rgba(255,60,60," + (flash * 0.22) + ")";
      ctx.fillRect(0, 0, W, H);
    }
  }

  function draw() {
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    if (shake > 0) {
      var sx = (Math.random() - 0.5) * shake * 14;
      var sy = (Math.random() - 0.5) * shake * 14;
      ctx.translate(sx, sy);
    }
    drawSky();
    drawWater();
    // reeds
    drawReeds();
    for (var i = 0; i < items.length; i++) {
      if (items[i].token) drawToken(items[i]); else drawCake(items[i]);
    }
    drawDuckChar();
    drawFx();
    if (state === "playing") drawHUD();
  }

  function drawReeds() {
    ctx.strokeStyle = "rgba(20,60,40,0.85)";
    ctx.lineWidth = 3;
    for (var i = 0; i < 5; i++) {
      var rx = 8 + i * 12;
      var hgt = 46 + (i % 3) * 14;
      ctx.beginPath();
      ctx.moveTo(rx, WATER_Y + 6);
      ctx.quadraticCurveTo(rx - 6, WATER_Y - hgt * 0.6, rx - 4, WATER_Y - hgt);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(rx + 6, WATER_Y + 6);
      ctx.quadraticCurveTo(rx + 12, WATER_Y - hgt * 0.5, rx + 10, WATER_Y - hgt + 12);
      ctx.stroke();
    }
    for (var j = 0; j < 5; j++) {
      var lx = W - 8 - j * 12;
      var lh = 40 + (j % 3) * 16;
      ctx.beginPath();
      ctx.moveTo(lx, WATER_Y + 6);
      ctx.quadraticCurveTo(lx + 6, WATER_Y - lh * 0.6, lx + 4, WATER_Y - lh);
      ctx.stroke();
    }
  }

  // ---------- loop ----------
  function frame(ts) {
    requestAnimationFrame(frame);
    if (!lastTs) lastTs = ts;
    var dt = Math.min((ts - lastTs) / 1000, 0.05);
    lastTs = ts;
    if (!paused) {
      if (state === "playing") update(dt);
      else tGlobal += dt;
      draw();
    }
  }

  resize();
  duckX = W / 2; duckTarget = W / 2;
  requestAnimationFrame(frame);
})();
</script>
</body>
</html>
